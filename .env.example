# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/diau"

# HTTP server
PORT=4000
HOST="0.0.0.0"
# Comma-separated origins allowed by CORS
# Sites allowed to call the API from a browser, comma-separated. Must include the live web
# address (e.g. https://diau.vercel.app): browsers open the live notifications socket here.
CORS_ORIGINS="http://localhost:3000"

# Signs API access tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_JWT_SECRET=""
API_JWT_TTL="7d"

# Frontend cache revalidation webhook (must match frontend REVALIDATE_SECRET)
FRONTEND_URL="http://localhost:3000"
REVALIDATE_SECRET=""

# Cloudinary — https://console.cloudinary.com/settings/api-keys
# Leave blank to keep seed images on their original free CDNs (DummyJSON, Picsum).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seeded super admin account (change before seeding anywhere public)
SEED_ADMIN_EMAIL="admin@diau.test"
SEED_ADMIN_PASSWORD="change-me-please"

# Shared with the frontend (INTERNAL_API_SECRET). Lets the Next.js server forward shopper IPs for rate limiting.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=""

# Web Push for notifications on phones and computers (DESIGN.md §5.22).
# Generate a pair with `npm run vapid:keys`; leave empty to turn push off
# (in-app notifications and live updates keep working).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact the push services can reach you at (mailto: or https:).
VAPID_SUBJECT="mailto:admin@example.com"
